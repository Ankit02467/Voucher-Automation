# ---- Build output ----
[Bb]in/
[Oo]bj/
*.dll
*.pdb
*.exe

# ---- Visual Studio ----
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.cache

# ---- NuGet ----
# packages.config is tracked; the restored packages folder is not.
packages/
*.nupkg

# ---- ASP.NET / publish ----
[Pp]ublish/
*.[Pp]ublish.xml
*.pubxml
*.pubxml.user
*.azurePubxml
App_Data/
Uploads/

# ---- Local config overrides ----
# Web.config itself IS tracked - it carries the "con" key the DAL depends on.
Web.*.config
*.Debug.config
*.Release.config

# ---- Operational logs ----
Tools/automove.log

# ---- Session notes ----
# Sits in the project root, so "git add -A" would otherwise pick it up. It
# records deployed state and open security threads and is not for the repository.
HANDOVER.md

# ---- Claude Code ----
# Machine-local permission approvals; not shared.
.claude/settings.local.json

# ---- OS ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
