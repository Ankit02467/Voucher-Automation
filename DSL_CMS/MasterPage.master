<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="DSL_CMS.MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">DSL CMS/OSS</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/site.css") %>?v=<%= AssetVersion %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <div class="layout">

        <aside class="sidebar">
            <div class="brand">
                <img src="<%= ResolveUrl("~/assets/img/logo/logo.png") %>" alt="Succeed Learners" />
                <span class="divider"></span>
                <button type="button" class="collapse" aria-label="Collapse menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M9 4v16M15 9l-3 3 3 3" />
                    </svg>
                </button>
            </div>

            <nav class="nav">
               <%-- <a href="<%= ResolveUrl("~/dashboard.aspx") %>" class='<%= NavClass("dashboard.aspx") %>'>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                    <span>Dashboard</span>
                </a>--%>

                <%-- Bookings / Training modules are not built yet - links are inert on purpose --%>
               <%-- <a href="#">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z" /></svg>
                    <span>Bookings</span>
                </a>
                <a href="#">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 2 9l10 5 10-5-10-5z" /><path d="M6 11.5V17c0 1.5 3 3 6 3s6-1.5 6-3v-5.5" /></svg>
                    <span>Training</span>
                </a>--%>

                <a href="<%= ResolveUrl("~/voucher-status.aspx") %>" class='<%= NavClass("voucher-status.aspx") %>'>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2" /><path d="M8 10l3 4M14 10l2 2" /></svg>
                    <span>Voucher Status</span>
                </a>
            </nav>
        </aside>

        <div class="main">
            <div class="topbar">
                <div class="user">
                    <span class="name"><%= CurrentUserName %></span>
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5a3.2 3.2 0 1 1 0 6.4A3.2 3.2 0 0 1 12 7zm0 14a8 8 0 0 1-5.7-2.4c.4-2.3 3-3.6 5.7-3.6s5.3 1.3 5.7 3.6A8 8 0 0 1 12 21z" />
                    </svg>
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="logout"
                        OnClick="lnkLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
                </div>
            </div>

            <div class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

    </div>
    </form>
</body>
</html>
