<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="DSL_CMS.MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">DSL CMS/OSS</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/site.css") %>?v=<%= AssetVersion %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <div class="layout">

        <aside class="sidebar">
            <div class="brand">
                <img src="<%= ResolveUrl("~/assets/img/logo/logo.png") %>" alt="Succeed Learners" />
                <span class="divider"></span>
                <button type="button" class="collapse" aria-label="Collapse menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M9 4v16M15 9l-3 3 3 3" />
                    </svg>
                </button>
            </div>

            <%-- Dashboard / Bookings / Training were removed on purpose - the
                 modules do not exist, so the links were dead. --%>
            <div class="navlbl">Vouchers</div>
            <nav class="nav">
                <a href="<%= ResolveUrl("~/voucher-status.aspx") %>" class='<%= NavClass("voucher-status.aspx") %>'>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v4a2 2 0 000 4v4H4v-4a2 2 0 000-4zM10 6v12" /></svg>
                    <span>Voucher Status</span>
                </a>
            </nav>
        </aside>

        <div class="main">
            <div class="topbar">
                <%-- Filters the provider list on Voucher Status. It is a real
                     control, not decoration - the source design showed a search
                     box that searched nothing. --%>
                <asp:Panel ID="pnlSearch" runat="server" Visible="false" CssClass="search"
                           DefaultButton="btnTopSearch">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
                    <asp:TextBox ID="txtTopSearch" runat="server" placeholder="Search providers…" />
                    <asp:Button ID="btnTopSearch" runat="server" Text="Search"
                        OnClick="btnTopSearch_Click" CausesValidation="false"
                        style="position:absolute; left:-9999px;" />
                </asp:Panel>

                <span class="tb-spacer"></span>

                <div class="user">
                    <span class="av"><%= UserInitials %></span>
                    <span class="who">
                        <b><%= CurrentUserName %></b>
                        <span><asp:Literal ID="litUserRole" runat="server" Text="Signed in" /></span>
                    </span>
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="logout"
                        OnClick="lnkLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
                </div>
            </div>

            <div class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

    </div>
    </form>

    <%-- Freezes the page behind an open dialog. The dialogs are server-rendered
         panels that only exist in the markup while they are open, so their mere
         presence is the signal. Runs again after every postback, which is how
         these dialogs open and close. --%>
    <script>
        (function () {
            function applyModalLock() {
                var body = document.body;
                if (document.querySelector('.modal-back')) {
                    // Hiding the scrollbar frees up its width and the page lurches
                    // sideways; hold that width back so nothing moves.
                    var gutter = window.innerWidth - document.documentElement.clientWidth;
                    if (gutter > 0) { body.style.paddingRight = gutter + 'px'; }
                    body.className += (body.className ? ' ' : '') + 'modal-open';
                } else {
                    body.className = body.className.replace(/\bmodal-open\b/g, '').trim();
                    body.style.paddingRight = '';
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', applyModalLock);
            } else {
                applyModalLock();
            }
        })();
    </script>
</body>
</html>
